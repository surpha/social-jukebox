# Supabase PostgreSQL connection (use the Session pooler URL; Render can't reach the IPv6-only direct host)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Spotify App Credentials (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback
SPOTIFY_LOGIN_REDIRECT_URI=http://localhost:8000/api/auth/spotify/callback

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# App Settings
APP_URL=http://localhost:8000
APP_NAME=Social Jukebox
